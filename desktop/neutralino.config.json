{
  "applicationId": "uz.telepat.telefon",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "storage.*",
    "debug.log",
    "window.*"
  ],
  "globalVariables": {
    "DEFAULT_UPDATE_URL": "https://telefon.telepat.uz/soft/telefon.exe",
    "CALL_API_PORT": "8088"
  },
  "modes": {
    "window": {
      "title": "Telefon",
      "width": 920,
      "height": 680,
      "minWidth": 720,
      "minHeight": 520,
      "center": true,
      "exitProcessOnClose": false,
      "icon": "/resources/icons/appIcon.png"
    }
  },
  "cli": {
    "binaryName": "telefon",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.5.0",
    "clientVersion": "5.5.0"
  }
}
