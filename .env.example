# Copy to .env (same folder as AiPhone.exe) and fill in:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# SIP listen address. 0.0.0.0 = all interfaces on this machine.
BIND_IP=0.0.0.0
# REQUIRED on many servers if AI does not hear you: this machine's LAN IP
# (the one the desk phone uses as SIP server). Put in SIP Contact/SDP.
# SIP_ADVERTISE_IP=192.168.1.50
SIP_PORT=5060
# Outbound caller ID on the desk phone (was "PBX")
# SIP_CALLER_ID=AiPhone
# SIP_CALLER_USER=100
# SIP extensions (inclusive). Default 100–110.
# SIP_EXT_MIN=100
# SIP_EXT_MAX=110
# MIC_GAIN=2.2

# Critical / phrase TTS: Edge primary, Gemini secondary
# EDGE_TTS_VOICE=uz-UZ-MadinaNeural
# EDGE_TTS_VOICE=uz-UZ-SardorNeural

# Local call API — see CALL_API.md
# CALL_API_KEY=change-me
# CALL_API_HOST=0.0.0.0
# CALL_API_PORT=8088
# CALL_API_RING_SEC=2

# Vazifa critical alerts (Hisob → API xabarlar → Telefon / Critical)
# Key alone scopes the user — no username needed.
VAZIFA_BASE_URL=https://vazifa.telepat.uz
VAZIFA_CRITICAL_KEY=
# VAZIFA_CRITICAL_POLL_SEC=10
# CRITICAL_RING_SEC=15
# CRITICAL_RETRY_GAP_SEC=60
# CRITICAL_MAX_ATTEMPTS=5
# CRITICAL_REPEAT_COUNT=2
# CRITICAL_REPEAT_BRIDGE=qaytaraman
# CRITICAL_BRIDGE_WAV=   # default: assets/critical/qaytaraman.wav
# CRITICAL_TTS_RATE=-20%
# CRITICAL_TTS_PITCH=-2Hz
# CRITICAL_LEAD_SILENCE_MS=600
