# Copy to .env (same folder as AiPhone.exe) and fill in:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# SIP listen address. 0.0.0.0 = all interfaces on this machine.
BIND_IP=0.0.0.0
# REQUIRED on many servers if AI does not hear you: this machine's LAN IP
# (the one the desk phone uses as SIP server). Put in SIP Contact/SDP.
# SIP_ADVERTISE_IP=192.168.1.50
# SIP_PORT=5060
# MIC_GAIN=2.2
